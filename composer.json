{
    "name": "huseyinfiliz/rewind",
    "description": "A year-in-review recap for Flarum.",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/huseyinfiliz/rewind/issues",
        "source": "https://github.com/huseyinfiliz/rewind",
        "forum": "https://discuss.flarum.org/d/39044-flarum-rewind-personalized-annual-recaps"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/likes": "Required for likes received/given and best friend metrics",
        "flarum/mentions": "Required for mentions received/given and best friend mentions metrics",
        "fof/badges": "Required for badges earned and badge leaderboard metrics",
        "fof/best-answer": "Required for best answers and leaderboard metrics",
        "flarum/tags": "Required for top tag metric",
        "fof/reactions": "Required for community total reactions metric",
        "flarum/emoji": "Required for emoji CDN image rendering"
    },
    "authors": [
        {
            "name": "Hüseyin Filiz",
            "email": "mysuperuser01@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "HuseyinFiliz\\Rewind\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Rewind",
            "category": "feature",
            "icon": {
                "name": "fas fa-history",
                "color": "#fff",
                "backgroundColor": "#3498db"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": true,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "frontendTesting": true,
                "backendTesting": true,
                "phpstan": true,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "HuseyinFiliz\\Rewind\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Runs static code analysis using PHPStan."
    },
    "require-dev": {
        "flarum/testing": "^2.0",
        "flarum/phpstan": "*"
    }
}